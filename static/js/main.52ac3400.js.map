import React, { useState, useEffect, useMemo } from 'react';
import {
    Container, Row, Col, Card, CardHeader, CardBody, Table, Button,
    Input,
    Pagination, PaginationItem, PaginationLink
} from 'reactstrap';
// No need for useNavigate or useParams from react-router-dom in a single file
// import { useNavigate, useParams } from 'react-router-dom';

// Assuming BreadCrumb is a simple component that takes title and pageTitle props
const BreadCrumb = ({ title, pageTitle }) => (
    <div className="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 className="mb-sm-0">{title}</h4>
        <div className="page-title-right">
            <ol className="breadcrumb m-0">
                <li className="breadcrumb-item"><a href="#">{pageTitle}</a></li>
                <li className="breadcrumb-item active">{title}</li>
            </ol>
        </div>
    </div>
);

const TaskManagementAndAssignmentPage = () => {
    // State to control which view is active: 'view' (TaskManagementPage) or 'assign' (AssignTasksToSite)
    const [mode, setMode] = useState('view'); // Default to viewing tasks

    // This would typically be dynamic, perhaps from a global context or fetched.
    // For this example, we'll assume a specific site is being managed.
    const [currentSiteId, setCurrentSiteId] = useState('site-a');
    const [currentSiteName, setCurrentSiteName] = useState('Site A - Mumbai HQ');

    // --- Data for TaskManagementPage (Assigned Tasks View) ---
    // This state will be updated when tasks are assigned from the 'assign' mode
    const [siteAssignedTasks, setSiteAssignedTasks] = useState([
        // Initial example tasks for 'site-a'
        { id: 1, primaryCategory: 'Electronics', subCategory: 'Smartphones', taskName: 'Install OS', subTask: 'we need to install the OS', orderNumber: 1, daysNeeded: 1, manhourNeeded: 8, isCompleted: false },
        { id: 3, primaryCategory: 'Apparel', subCategory: 'T-Shirts', taskName: 'Fabric Inspection', orderNumber: 2, daysNeeded: 0.8, manhourNeeded: 5, isCompleted: false },
        { id: 9, primaryCategory: 'Flooring', subCategory: 'Cement', taskName: 'Watering', subTask: 'make mixture of cement', orderNumber: 3, daysNeeded: 1, manhourNeeded: 8, isCompleted: false },
    ]);

    // --- Data for AssignTasksToSite (Master Tasks and Selection) ---
    const [primaryCategories] = useState([
        { id: 1, sequenceNumber: 1, name: 'Electronics' },
        { id: 2, sequenceNumber: 2, name: 'Books' },
        { id: 3, sequenceNumber: 3, name: 'Apparel' },
        { id: 4, sequenceNumber: 4, name: 'Flooring' },
    ]);

    const [subCategories] = useState([
        { id: 1, name: 'Smartphones', primaryCategoryId: 1 },
        { id: 2, name: 'Laptops', primaryCategoryId: 1 },
        { id: 3, name: 'Fiction', primaryCategoryId: 2 },
        { id: 4, name: 'T-Shirts', primaryCategoryId: 3 },
        { id: 5, name: 'Cement', primaryCategoryId: 4 },
    ]);

    const [allMasterTasks] = useState([
        { id: 1, subCategoryId: 1, taskName: 'Install OS', orderNumber: 1, daysNeeded: 1, manhourNeeded: 8 },
        { id: 2, subCategoryId: 1, taskName: 'Software Setup', orderNumber: 2, daysNeeded: 0.5, manhourNeeded: 4 },
        { id: 3, subCategoryId: 4, taskName: 'Fabric Inspection', orderNumber: 1, daysNeeded: 1, manhourNeeded: 6 },
        { id: 4, subCategoryId: 2, taskName: 'Hardware Check', orderNumber: 3, daysNeeded: 0.2, manhourNeeded: 2 },
        { id: 5, subCategoryId: 3, taskName: 'Book Binding', orderNumber: 1, daysNeeded: 0.3, manhourNeeded: 2.5 },
        { id: 6, subCategoryId: 4, taskName: 'Stitching Quality Check', orderNumber: 2, daysNeeded: 0.7, manhourNeeded: 5 },
        { id: 7, subCategoryId: 5, taskName: 'Watering', orderNumber: 1, daysNeeded: 1, manhourNeeded: 8 },
        { id: 8, subCategoryId: 5, taskName: 'Mixing', orderNumber: 2, daysNeeded: 0.5, manhourNeeded: 4 },
    ]);

    // State to manage tasks selected for this specific site during assignment mode
    const [selectedSiteTasks, setSelectedSiteTasks] = useState([]);

    // Simulate fetching already assigned tasks when entering 'assign' mode for a site
    useEffect(() => {
        if (mode === 'assign') {
            // Initialize selectedSiteTasks based on allMasterTasks and currently assigned tasks
            const initialSelected = allMasterTasks.map(masterTask => {
                const existingAssignedTask = siteAssignedTasks.find(st => st.id === masterTask.id);
                if (existingAssignedTask) {
                    // Task is already assigned, so it should be checked and use its assigned values
                    return { ...masterTask, ...existingAssignedTask, isChecked: true };
                }
                // Not assigned, default to unchecked with master values
                return { ...masterTask, isChecked: false };
            });
            setSelectedSiteTasks(initialSelected);
        }
    }, [mode, allMasterTasks, siteAssignedTasks]); // Re-run if mode changes or master/assigned tasks change

    // --- Common Pagination Logic ---
    const [currentPage, setCurrentPage] = useState(1);
    const [itemsPerPage] = useState(5); // Can be different for each mode if needed

    // Determine tasks for current view based on mode
    const tasksToPaginate = mode === 'view' ? siteAssignedTasks : allMasterTasks;
    const totalPages = Math.ceil(tasksToPaginate.length / itemsPerPage);

    const currentDisplayItems = useMemo(() => {
        const sortedTasks = [...(mode === 'view' ? siteAssignedTasks : selectedSiteTasks)].sort((a, b) => {
            const orderA = typeof a.orderNumber === 'number' ? a.orderNumber : Infinity;
            const orderB = typeof b.orderNumber === 'number' ? b.orderNumber : Infinity;
            return orderA - orderB;
        });

        const indexOfLastItem = currentPage * itemsPerPage;
        const indexOfFirstItem = indexOfLastItem - itemsPerPage;
        return sortedTasks.slice(indexOfFirstItem, indexOfLastItem);
    }, [mode, siteAssignedTasks, selectedSiteTasks, currentPage, itemsPerPage]);


    const paginate = (pageNumber) => {
        if (pageNumber > 0 && pageNumber <= totalPages) {
            setCurrentPage(pageNumber);
        }
    };

    // --- Handlers for TaskManagementPage (View Mode) ---
    const handleCompletionToggle = (taskId) => {
        setSiteAssignedTasks(prevTasks =>
            prevTasks.map(task =>
                task.id === taskId ? { ...task, isCompleted: !task.isCompleted } : task
            )
        );
        // In a real app, you'd send this update to your backend.
    };

    const handleAddTasksClick = () => {
        setMode('assign'); // Switch to assignment mode
        setCurrentPage(1); // Reset pagination for the new view
    };

    // --- Handlers for AssignTasksToSite (Assign Mode) ---
    const getPrimaryCategoryName = (primaryCategoryId) => {
        const category = primaryCategories.find(cat => cat.id === primaryCategoryId);
        return category ? category.name : 'N/A';
    };

    const getSubCategory = (subCategoryId) => {
        return subCategories.find(subCat => subCat.id === subCategoryId);
    };

    const getSubCategoryName = (subCategoryId) => {
        const subCat = getSubCategory(subCategoryId);
        return subCat ? subCat.name : 'N/A';
    };

    const handleTaskCheckboxChange = (taskId) => {
        setSelectedSiteTasks(prevTasks => {
            const existingTaskIndex = prevTasks.findIndex(task => task.id === taskId);

            if (existingTaskIndex > -1) {
                const updatedTasks = [...prevTasks];
                updatedTasks[existingTaskIndex] = {
                    ...updatedTasks[existingTaskIndex],
                    isChecked: !updatedTasks[existingTaskIndex].isChecked
                };
                return updatedTasks;
            } else {
                const masterTask = allMasterTasks.find(task => task.id === taskId);
                if (masterTask) {
                    return [...prevTasks, { ...masterTask, isChecked: true }];
                }
                return prevTasks;
            }
        });
    };

    const handleEditableChange = (taskId, field, value) => {
        setSelectedSiteTasks(prevTasks => {
            return prevTasks.map(task =>
                task.id === taskId && task.isChecked // Only update if checked
                    ? { ...task, [field]: parseFloat(value) || 0 }
                    : task
            );
        });
    };

    const handleCloseAssignMode = () => {
        setMode('view'); // Switch back to view mode
        setCurrentPage(1); // Reset pagination
    };

    const handleSubmitAssignment = () => {
        const tasksToSave = selectedSiteTasks.filter(task => task.isChecked).map(({ isChecked, ...rest }) => ({
            ...rest,
            primaryCategory: getPrimaryCategoryName(getSubCategory(rest.subCategoryId)?.primaryCategoryId),
            subCategory: getSubCategoryName(rest.subCategoryId),
            subTask: rest.subTask || '' // Ensure subTask exists, even if empty
        }));

        setSiteAssignedTasks(tasksToSave); // Update the main assigned tasks state
        alert(`Tasks assigned to ${currentSiteName} successfully!`);
        setMode('view'); // Switch back to view mode
        setCurrentPage(1); // Reset pagination
    };


    return (
        <React.Fragment>
          
                <Container fluid>
                    {mode === 'view' && (
                        <BreadCrumb title="Task Management" pageTitle="Home" />
                    )}
                    {mode === 'assign' && (
                        <BreadCrumb title={`Assign Tasks to ${currentSiteName}`} pageTitle="Task Management" />
                    )}

                    <Row className="mt-2">
                        <Col lg={12}>
                            <Card>
                                {mode === 'view' && (
                                    <CardHeader className="d-flex justify-content-between align-items-center">
                                        <h5 className="card-title mb-0">Assigned Tasks for {currentSiteName}</h5>
                                        <Button color="primary" onClick={handleAddTasksClick}>Add Tasks</Button>
                                    </CardHeader>
                                )}
                                {mode === 'assign' && (
                                    <CardHeader className="d-flex justify-content-between align-items-center">
                                        <h5 className="card-title mb-0">{currentSiteName} - Task Selection</h5>
                                        <Button color="secondary" onClick={handleCloseAssignMode}>Close</Button>
                                    </CardHeader>
                                )}
                                <CardBody>
                                    <div className="table-responsive">
                                        {mode === 'view' && (
                                            <Table className="table-bordered table-nowrap mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Completed</th>
                                                        <th scope="col">Order Number</th>
                                                        <th scope="col">Primary Category</th>
                                                        <th scope="col">Sub Category</th>
                                                        <th scope="col">Primary Task</th>
                                                        <th scope="col">Sub Task</th>
                                                        <th scope="col">Days Needed</th>
                                                        <th scope="col">Manhour Needed</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {currentDisplayItems.length > 0 ? (
                                                        currentDisplayItems.map(task => (
                                                            <tr key={task.id}>
                                                                <td>
                                                                    <Input
                                                                        type="checkbox"
                                                                        checked={task.isCompleted}
                                                                        onChange={() => handleCompletionToggle(task.id)}
                                                                    />
                                                                </td>
                                                                <td>{task.orderNumber}</td>
                                                                <td>{task.primaryCategory}</td>
                                                                <td>{task.subCategory}</td>
                                                                <td>{task.taskName}</td>
                                                                <td>{task.subTask}</td>
                                                                <td>{task.daysNeeded}</td>
                                                                <td>{task.manhourNeeded}</td>
                                                            </tr>
                                                        ))
                                                    ) : (
                                                        <tr>
                                                            <td colSpan="8" className="text-center">No tasks assigned to this site yet.</td>
                                                        </tr>
                                                    )}
                                                </tbody>
                                            </Table>
                                        )}

                                        {mode === 'assign' && (
                                            <Table className="table-bordered table-nowrap mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Select</th>
                                                        <th scope="col">Order Number</th>
                                                        <th scope="col">Task Name</th>
                                                        <th scope="col">Sub Category</th>
                                                        <th scope="col">Primary Category</th>
                                                        <th scope="col">Days Needed</th>
                                                        <th scope="col">Manhour Needed</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {currentDisplayItems.length > 0 ? (
                                                        currentDisplayItems.map(task => {
                                                            // For display in assign mode, we get the category info from master data
                                                            const subCategory = getSubCategory(task.subCategoryId);
                                                            const primaryCategoryName = subCategory ? getPrimaryCategoryName(subCategory.primaryCategoryId) : 'N/A';

                                                            // Find the current site-specific values for daysNeeded and manhourNeeded
                                                            // We are using 'task' here directly from currentDisplayItems which is already merged
                                                            const siteSpecificTask = selectedSiteTasks.find(st => st.id === task.id) || task;


                                                            return (
                                                                <tr key={task.id}>
                                                                    <td>
                                                                        <Input
                                                                            type="checkbox"
                                                                            checked={siteSpecificTask.isChecked || false}
                                                                            onChange={() => handleTaskCheckboxChange(task.id)}
                                                                        />
                                                                    </td>
                                                                    <td>{task.orderNumber}</td>
                                                                    <td>{task.taskName}</td>
                                                                    <td>{getSubCategoryName(task.subCategoryId)}</td>
                                                                    <td>{primaryCategoryName}</td>
                                                                    <td>
                                                                        <Input
                                                                            type="number"
                                                                            value={siteSpecificTask.daysNeeded}
                                                                            onChange={(e) => handleEditableChange(task.id, 'daysNeeded', e.target.value)}
                                                                            min="0"
                                                                            step="0.5"
                                                                            disabled={!siteSpecificTask.isChecked}
                                                                        />
                                                                    </td>
                                                                    <td>
                                                                        <Input
                                                                            type="number"
                                                                            value={siteSpecificTask.manhourNeeded}
                                                                            onChange={(e) => handleEditableChange(task.id, 'manhourNeeded', e.target.value)}
                                                                            min="0"
                                                                            step="0.5"
                                                                            disabled={!siteSpecificTask.isChecked}
                                                                        />
                                                                    </td>
                                                                </tr>
                                                            );
                                                        })
                                                    ) : (
                                                        <tr>
                                                            <td colSpan="7" className="text-center">No tasks available to assign.</td>
                                                        </tr>
                                                    )}
                                                </tbody>
                                            </Table>
                                        )}
                                    </div>

                                    {/* Pagination Controls - Rendered based on the current mode's data */}
                                    {totalPages > 1 && (
                                        <div className="d-flex justify-content-end mt-3">
                                            <Pagination>
                                                <PaginationItem disabled={currentPage === 1}>
                                                    <PaginationLink previous onClick={() => paginate(currentPage - 1)} />
                                                </PaginationItem>
                                                {[...Array(totalPages)].map((_, i) => (
                                                    <PaginationItem key={i + 1} active={i + 1 === currentPage}>
                                                        <PaginationLink onClick={() => paginate(i + 1)}>
                                                            {i + 1}
                                                        </PaginationLink>
                                                    </PaginationItem>
                                                ))}
                                                <PaginationItem disabled={currentPage === totalPages}>
                                                    <PaginationLink next onClick={() => paginate(currentPage + 1)} />
                                                </PaginationItem>
                                            </Pagination>
                                        </div>
                                    )}

                                    {mode === 'assign' && (
                                        <div className="d-flex justify-content-end mt-4">
                                            <Button color="primary" onClick={handleSubmitAssignment}>Submit</Button>
                                        </div>
                                    )}
                                </CardBody>
                            </Card>
                        </Col>
                    </Row>
                </Container>

        </React.Fragment>
    );
};

export default TaskManagementAndAssignmentPage;